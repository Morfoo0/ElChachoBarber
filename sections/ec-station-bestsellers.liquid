{% comment %}
  Sección "Mi Estación — Lo más vendido" del rediseño El Chacho.
  Vitrina de los productos más vendidos (colección existente) sin historial por
  usuario, con las 4 rutas de compra y la tarjeta de producto nativa del tema.
{% endcomment %}

<div class="section-background ec-best__bg"></div>
<div
  class="ec-best section section--{{ section.settings.section_width }} spacing-style"
  style="{% render 'spacing-padding', settings: section.settings %}"
  {{ section.shopify_attributes }}
>
  {%- liquid
    assign coll_handle = section.settings.collection | strip
    assign coll = collections[coll_handle]
    assign max_products = section.settings.max_products | default: 8 | times: 1
    assign view_all_label = section.settings.view_all_label | default: 'Ver todos'
    assign view_all_link = section.settings.view_all_link | default: coll.url
    assign shown = 0
  -%}

  <div class="ec-best__head">
    {% if section.settings.eyebrow != blank %}
      <p class="ec-eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}
    {% if section.settings.title != blank %}
      <h2 class="ec-best__title">{{ section.settings.title | escape }}</h2>
    {% endif %}
    {% if section.settings.intro != blank %}
      <p class="ec-best__intro">{{ section.settings.intro | escape }}</p>
    {% endif %}
  </div>

  {% capture best_items %}
    {% if coll != blank %}
      {% for product in coll.products %}
        {% if product.available and product.price > 0 and shown < max_products %}
          {% assign shown = shown | plus: 1 %}
          <div class="ec-best__item">
            {% content_for 'block', type: '_product-card', id: 'static-product-card', closest.product: product, product_view_context: 'collection' %}
          </div>
        {% endif %}
      {% endfor %}
    {% endif %}
  {% endcapture %}

  {% if shown > 0 %}
    <div class="ec-best__grid">{{ best_items }}</div>
    {% if view_all_link != blank %}
      <a class="ec-best__viewall" href="{{ view_all_link }}">{{ view_all_label | escape }}</a>
    {% endif %}
  {% else %}
    <p class="ec-best__empty">Próximamente</p>
  {% endif %}

  <div class="ec-best__routes">
    <span class="ec-best__routes-label">Rutas de compra</span>
    <ul class="ec-best__routes-list">
      {% for i in (1..4) %}
        {%- liquid
          assign route_label_key = 'route_' | append: i | append: '_label'
          assign route_link_key = 'route_' | append: i | append: '_link'
          assign route_label = section.settings[route_label_key] | strip
          assign route_link = section.settings[route_link_key]
        -%}
        {% if route_label != blank and route_link != blank %}
          <li class="ec-best__route">
            <a class="ec-best__route-link" href="{{ route_link }}">
              {{ route_label | escape }}
              <span class="ec-best__arrow" aria-hidden="true">&rarr;</span>
            </a>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>
</div>

{% stylesheet %}
  .ec-best__bg {
    background-color: var(--ec-ink);
  }

  .ec-best {
    color: var(--ec-cream);
  }

  .ec-best__head {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin-bottom: 3rem;
  }

  .ec-best__title {
    margin: 0;
    font-family: var(--ec-display);
    font-size: clamp(2.75rem, 7vw, 5.5rem);
    line-height: 0.96;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }

  .ec-best__intro {
    margin: 0;
    max-width: 52ch;
    color: rgb(244 239 229 / 0.78);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .ec-best__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 40px 20px;
  }

  .ec-best__item {
    height: 100%;
  }

  .ec-best__item .product-card {
    display: grid;
    width: 100%;
    height: 100%;
  }

  .ec-best__viewall {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 2.5rem;
    font-family: var(--font-subheading--family);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ec-cream);
    border-bottom: 1px solid var(--ec-red);
    padding-bottom: 0.25rem;
  }

  .ec-best__viewall::after {
    content: '\2192';
  }

  .ec-best__viewall:hover {
    color: var(--ec-red);
  }

  .ec-best__empty {
    margin: 0 0 2rem;
    font-family: var(--font-subheading--family);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(244 239 229 / 0.55);
  }

  .ec-best__routes {
    margin-top: 3.5rem;
    border-top: 1px solid rgb(244 239 229 / 0.18);
    padding-top: 1.5rem;
  }

  .ec-best__routes-label {
    display: block;
    margin-bottom: 1.25rem;
    font-family: var(--font-subheading--family);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(244 239 229 / 0.55);
  }

  .ec-best__routes-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .ec-best__route-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-subheading--family);
    font-size: 1rem;
    letter-spacing: 0.02em;
    text-decoration: none;
    color: var(--ec-cream);
    transition: color 0.3s var(--animation-easing);
  }

  .ec-best__route-link:hover {
    color: var(--ec-red);
  }

  .ec-best__arrow {
    transition: transform 0.3s var(--animation-easing);
  }

  .ec-best__route-link:hover .ec-best__arrow {
    transform: translateX(6px);
  }

  @media screen and (min-width: 750px) {
    .ec-best__head {
      grid-template-columns: 7fr 5fr;
      align-items: end;
      column-gap: 2.5rem;
    }

    .ec-best__head .ec-eyebrow,
    .ec-best__head .ec-best__title {
      grid-column: 1;
    }

    .ec-best__head .ec-best__intro {
      grid-column: 2;
      grid-row: 1 / span 3;
      align-self: end;
    }

    .ec-best__routes-list {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
    }
  }

  @media screen and (max-width: 749px) {
    .ec-best__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 28px 16px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Mi Estación",
  "tag": "section",
  "class": "ec-station-bestsellers-section",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Etiqueta superior",
      "default": "Lo más vendido"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Mi Estación"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Texto introductorio",
      "default": "Los productos que más se venden en El Chacho. Las herramientas y consumibles que los barberos eligen todos los días."
    },
    {
      "type": "text",
      "id": "collection",
      "label": "Colección (handle)",
      "info": "Escribe el handle de la colección, por ejemplo: insumos",
      "default": "insumos"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Máximo de productos",
      "min": 1,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Texto del enlace “Ver todos”",
      "default": "Ver todos"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "Enlace “Ver todos” (opcional)",
      "info": "Si se deja vacío se usa la URL de la colección."
    },
    {
      "type": "header",
      "content": "Ruta 1"
    },
    {
      "type": "text",
      "id": "route_1_label",
      "label": "Etiqueta",
      "default": "Reabastecer"
    },
    {
      "type": "url",
      "id": "route_1_link",
      "label": "Enlace"
    },
    {
      "type": "header",
      "content": "Ruta 2"
    },
    {
      "type": "text",
      "id": "route_2_label",
      "label": "Etiqueta",
      "default": "Mejorar el equipo"
    },
    {
      "type": "url",
      "id": "route_2_link",
      "label": "Enlace"
    },
    {
      "type": "header",
      "content": "Ruta 3"
    },
    {
      "type": "text",
      "id": "route_3_label",
      "label": "Etiqueta",
      "default": "Equipar una estación"
    },
    {
      "type": "url",
      "id": "route_3_link",
      "label": "Enlace"
    },
    {
      "type": "header",
      "content": "Ruta 4"
    },
    {
      "type": "text",
      "id": "route_4_label",
      "label": "Etiqueta",
      "default": "Comprar por volumen"
    },
    {
      "type": "url",
      "id": "route_4_link",
      "label": "Enlace"
    },
    {
      "type": "header",
      "content": "Diseño"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Ancho de la sección",
      "options": [
        { "value": "page-width", "label": "Página" },
        { "value": "full-width", "label": "Completo" }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Relleno superior",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Relleno inferior",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ],
  "presets": [
    {
  "name": "Mi Estación",
      "category": "El Chacho"
    }
  ]
}
{% endschema %}
