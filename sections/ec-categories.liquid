{% comment %}
  Sección "Categorías" del rediseño El Chacho — Supply Culture.
  Cuatro colecciones en composición editorial asimétrica (no tarjetas idénticas).
{% endcomment %}

<div
  id="categorias"
  class="ec-categories section section--{{ section.settings.section_width }} spacing-style"
  style="{% render 'spacing-padding', settings: section.settings %} --ec-cats-gap: {{ section.settings.gap }}px;"
  {{ section.shopify_attributes }}
>
  {% if section.settings.eyebrow != blank %}
    <p class="ec-eyebrow">{{ section.settings.eyebrow | escape }}</p>
  {% endif %}

  <div class="ec-cats">
    {% for block in section.blocks %}
      {%- liquid
        assign collection = block.settings.collection
        assign title = block.settings.title | default: collection.title
        assign img = block.settings.image | default: collection.image
        assign url = collection.url
      -%}
      <div
        class="ec-cat ec-cat--{{ forloop.index }}"
        {{ block.shopify_attributes }}
      >
        {% if url != blank %}
          <a class="ec-cat__link" href="{{ url }}" aria-label="{{ title | escape }}">
        {% else %}
          <div class="ec-cat__link">
        {% endif %}
          <div class="ec-cat__media">
            {% if img != blank %}
              {{
                img
                | image_url: width: 1600
                | image_tag:
                  loading: 'lazy',
                  widths: '480, 720, 960, 1200, 1600',
                  sizes: '(min-width: 750px) 50vw, 100vw',
                  class: 'ec-cat__img',
                  alt: img.alt | default: title
              }}
            {% endif %}
          </div>
          <div class="ec-cat__overlay">
            <span class="ec-cat__index">{{ forloop.index | prepend: '0' }}</span>
            <h3 class="ec-cat__title">{{ title | escape }}</h3>
            <span class="ec-cat__cta">Ver categoría</span>
          </div>
        {% if url != blank %}
          </a>
        {% else %}
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

{% stylesheet %}
  .ec-cats {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--ec-cats-gap);
  }

  .ec-cat {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--ec-ink);
  }

  .ec-cat__link {
    position: absolute;
    inset: 0;
    display: block;
    color: var(--ec-cream);
    text-decoration: none;
  }

  .ec-cat__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .ec-cat__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--animation-easing);
  }

  .ec-cat__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.5rem;
    padding: 1.5rem;
    background: linear-gradient(180deg, rgb(11 11 11 / 0) 34%, rgb(11 11 11 / 0.8) 100%);
  }

  .ec-cat__index {
    font-family: var(--font-subheading--family);
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--ec-red);
  }

  .ec-cat__title {
    margin: 0;
    font-family: var(--ec-display);
    font-size: clamp(1.75rem, 3.4vw, 3rem);
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    color: var(--ec-cream);
  }

  .ec-cat__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-subheading--family);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .ec-cat__cta::after {
    content: '\2192';
    transition: transform 0.3s var(--animation-easing);
  }

  .ec-cat:hover .ec-cat__img {
    transform: scale(1.06);
  }

  .ec-cat:hover .ec-cat__cta::after {
    transform: translateX(6px);
  }

  @media screen and (min-width: 750px) {
    .ec-cats {
      grid-template-columns: repeat(2, 1fr);
    }

    .ec-cat {
      aspect-ratio: 1 / 1;
    }
  }

  @media screen and (max-width: 749px) {
    .ec-cat {
      aspect-ratio: 4 / 3;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Categorías editorial",
  "tag": "section",
  "class": "ec-categories-section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Etiqueta superior",
      "default": "Categorías"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Ancho de la sección",
      "options": [
        { "value": "page-width", "label": "Página" },
        { "value": "full-width", "label": "Completo" }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Separación",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Relleno"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Superior",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Inferior",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Categoría",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Colección"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título (opcional)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen (opcional)",
          "info": "Si se deja vacía se usa la imagen de la colección."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Categorías editorial",
      "category": "El Chacho",
      "blocks": {
        "block_1": { "type": "category", "settings": { "title": "Máquinas" } },
        "block_2": { "type": "category", "settings": { "title": "Cuchillas" } },
        "block_3": { "type": "category", "settings": { "title": "Cuidado" } },
        "block_4": { "type": "category", "settings": { "title": "Accesorios" } }
      },
      "block_order": ["block_1", "block_2", "block_3", "block_4"]
    }
  ]
}
{% endschema %}
