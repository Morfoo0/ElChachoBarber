{% doc %}
  @prompt
    barra de comentarios y calificación 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign ai_form_id = 'ReviewForm-' | append: ai_gen_id %}

{% style %}
  .ai-review-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    box-sizing: border-box;
    padding: 24px;
    color: #1f1f1f;
    background: #ffffff;
    border: 1px solid #dedede;
    border-radius: 14px;
    font-family: inherit;
  }
  .ai-review-{{ ai_gen_id }}__heading { margin: 0 0 8px; font-size: 22px; line-height: 1.25; }
  .ai-review-{{ ai_gen_id }}__intro { margin: 0 0 18px; color: #444444; line-height: 1.55; }
  .ai-review-{{ ai_gen_id }}__form-title { margin: 0 0 14px; font-size: 18px; }
  .ai-review-{{ ai_gen_id }}__field { margin-bottom: 12px; }
  .ai-review-{{ ai_gen_id }}__label { display: block; margin-bottom: 5px; font-weight: 600; }
  .ai-review-{{ ai_gen_id }}__input, .ai-review-{{ ai_gen_id }}__textarea, .ai-review-{{ ai_gen_id }}__select { box-sizing: border-box; width: 100%; padding: 11px 12px; color: #1f1f1f; background: #ffffff; border: 1px solid #767676; border-radius: 6px; font: inherit; }
  .ai-review-{{ ai_gen_id }}__textarea { min-height: 100px; resize: vertical; }
  .ai-review-{{ ai_gen_id }}__button { display: inline-flex; justify-content: center; align-items: center; padding: 12px 20px; border: 0; border-radius: 14px; background: #5f0203; color: #ffffff; font: inherit; font-weight: 700; cursor: pointer; }
  .ai-review-{{ ai_gen_id }}__button:focus-visible, .ai-review-{{ ai_gen_id }}__input:focus-visible, .ai-review-{{ ai_gen_id }}__textarea:focus-visible, .ai-review-{{ ai_gen_id }}__select:focus-visible { outline: 3px solid #0b2972; outline-offset: 2px; }
  .ai-review-{{ ai_gen_id }}__notice { padding: 12px; background: #f3f3f3; border-radius: 6px; }
  @media screen and (max-width: 749px) { .ai-review-{{ ai_gen_id }} { padding: 18px; } }
{% endstyle %}

<div class="ai-review-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <h2 class="ai-review-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
  {% if block.settings.intro != blank %}<p class="ai-review-{{ ai_gen_id }}__intro">{{ block.settings.intro | escape }}</p>{% endif %}
  <h3 class="ai-review-{{ ai_gen_id }}__form-title">Deja tu comentario</h3>
  {% form 'contact', id: ai_form_id %}
    {% if form.posted_successfully? %}
      <p class="ai-review-{{ ai_gen_id }}__notice" role="status">Gracias. Recibimos tu comentario.</p>
    {% else %}
      {% if form.errors %}<div class="ai-review-{{ ai_gen_id }}__notice" role="alert">Revisa los datos ingresados e inténtalo de nuevo.</div>{% endif %}
      <input type="hidden" name="contact[Asunto]" value="Comentario de producto: {{ product.title | escape }}">
      <div class="ai-review-{{ ai_gen_id }}__field">
        <label class="ai-review-{{ ai_gen_id }}__label" for="ReviewName-{{ ai_gen_id }}">Nombre</label>
        <input class="ai-review-{{ ai_gen_id }}__input" id="ReviewName-{{ ai_gen_id }}" type="text" name="contact[name]" autocomplete="name" required>
      </div>
      <div class="ai-review-{{ ai_gen_id }}__field">
        <label class="ai-review-{{ ai_gen_id }}__label" for="ReviewEmail-{{ ai_gen_id }}">Correo electrónico</label>
        <input class="ai-review-{{ ai_gen_id }}__input" id="ReviewEmail-{{ ai_gen_id }}" type="email" name="contact[email]" autocomplete="email" required>
      </div>
      <div class="ai-review-{{ ai_gen_id }}__field">
        <label class="ai-review-{{ ai_gen_id }}__label" for="ReviewRating-{{ ai_gen_id }}">Calificación</label>
        <select class="ai-review-{{ ai_gen_id }}__select" id="ReviewRating-{{ ai_gen_id }}" name="contact[Calificación]" required>
          <option value="5">★★★★★ — 5 estrellas</option>
          <option value="4">★★★★☆ — 4 estrellas</option>
          <option value="3">★★★☆☆ — 3 estrellas</option>
          <option value="2">★★☆☆☆ — 2 estrellas</option>
          <option value="1">★☆☆☆☆ — 1 estrella</option>
        </select>
      </div>
      <div class="ai-review-{{ ai_gen_id }}__field">
        <label class="ai-review-{{ ai_gen_id }}__label" for="ReviewMessage-{{ ai_gen_id }}">Comentario</label>
        <textarea class="ai-review-{{ ai_gen_id }}__textarea" id="ReviewMessage-{{ ai_gen_id }}" name="contact[body]" required></textarea>
      </div>
      <button class="ai-review-{{ ai_gen_id }}__button" type="submit">Enviar comentario</button>
    {% endif %}
  {% endform %}
</div>

{% schema %}
{
  "name": "Comentarios y rating",
  "settings": [
    { "type": "header", "content": "Contenido" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Opiniones de clientes" },
    { "type": "textarea", "id": "intro", "label": "Texto introductorio", "default": "Comparte tu experiencia con este producto." },
    { "type": "range", "id": "desktop_width_percent", "label": "Ancho en escritorio", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 }
  ],
  "presets": [{ "name": "Comentarios y rating" }],
  "tag": null,
  "class": "review-rating-block"
}
{% endschema %}